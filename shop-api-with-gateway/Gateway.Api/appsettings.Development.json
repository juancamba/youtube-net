{
  "Logging": {
    "LogLevel": {
       "Default": "Information",
      "Microsoft": "Information",
      "Yarp": "Trace",
      "Microsoft.ReverseProxy": "Trace"
    }
  },
   "ReverseProxy": {
    "Routes": {
      "usersRoute": {
        "ClusterId": "usersCluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/users" }
        ]
      },
      "ordersRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/orders" }
        ]
      },
      "catalogRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
         "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      }
    },
    "Clusters": {
      "usersCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "ordersCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      },
      "catalogCluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103/"
          }
        }
      }
    }
  }
}
